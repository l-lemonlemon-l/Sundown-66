{
  "name": "sundown-66",
  "productName": "Sundown 66",
  "version": "1.4.0",
  "description": "70s-style Route 66 arcade road racer",
  "main": "main.js",
  "author": "Leon",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-packager . \"Sundown 66\" --platform=win32 --arch=x64 --out=dist --overwrite",
    "build:mac": "electron-packager . \"Sundown 66\" --platform=darwin --arch=arm64,x64 --out=dist --overwrite",
    "build:linux": "electron-packager . \"Sundown 66\" --platform=linux --arch=x64 --out=dist --overwrite"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.1"
  }
}
